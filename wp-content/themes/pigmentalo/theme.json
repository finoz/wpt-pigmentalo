{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,

  "settings": {
    "layout": {
      "contentSize": "1280px",
      "wideSize":    "1440px"
    },

    "spacing": {
      "spacingSizes": [
        { "slug": "s",  "size": "2.4rem", "name": "S"  },
        { "slug": "m",  "size": "4.0rem", "name": "M"  },
        { "slug": "l",  "size": "6.4rem", "name": "L"  },
        { "slug": "xl", "size": "9.6rem", "name": "XL" }
      ]
    },

    "color": {
      "palette": [
        { "slug": "primary",     "color": "#87235a", "name": "Viola" },
        { "slug": "secondary",   "color": "#1c52ac", "name": "Blu" },
        { "slug": "accent",      "color": "#e5ce00", "name": "Giallo" },
        { "slug": "surface",     "color": "#f0f0f0", "name": "Light Gray" },
        { "slug": "surface-alt", "color": "#e0e0e0", "name": "Surface Alt" },
        { "slug": "text",        "color": "#000000", "name": "Black" },
        { "slug": "text-light",  "color": "#555555", "name": "Medium Gray" },
        { "slug": "white",       "color": "#ffffff", "name": "White" }
      ],
      "gradients": [
        {
          "slug": "brand",
          "gradient": "linear-gradient(-45deg, #87235a 0%, #1c52ac 100%)",
          "name": "Viola - Blu"
        },
        {
          "slug": "viola-giallo",
          "gradient": "linear-gradient(-45deg, #87235a 0%, #e5ce00 100%)",
          "name": "Viola - Giallo"
        },
        {
          "slug": "blu-giallo",
          "gradient": "linear-gradient(-45deg, #1c52ac 0%, #e5ce00 100%)",
          "name": "Blu - Giallo"
        }
      ],
      "duotone": [
        {
          "slug": "bw",
          "name": "Bianco e Nero",
          "colors": [ "#000000", "#ffffff" ]
        },
        {
          "slug": "duotone-violablu",
          "name": "Viola - Blu",
          "colors": [ "#87235a", "#1c52ac" ]
        },
        {
          "slug": "duotone-violagiallo",
          "name": "Viola - Giallo",
          "colors": [ "#87235a", "#e5ce00" ]
        },
        {
          "slug": "duotone-blugiallo",
          "name": "Blu - Giallo",
          "colors": [ "#1c52ac", "#e5ce00" ]
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontSizes": [
        { "slug": "xxs",  "size": "1.0rem", "name": "Nota"       },
        { "slug": "xs",   "size": "1.4rem", "name": "Didascalia" },
        { "slug": "sm",   "size": "1.6rem", "name": "Etichetta"  },
        { "slug": "base", "size": "1.8rem", "name": "Corpo"      },
        { "slug": "md",   "size": "2.0rem", "name": "Titolo S"   },
        { "slug": "lg",   "size": "2.8rem", "name": "Titolo M"   },
        { "slug": "xl",   "size": "3.6rem", "name": "Titolo L"   },
        { "slug": "xxl",  "size": "4.4rem", "name": "Display"    },
        { "slug": "xxxl",  "size": "5.0rem", "name": "Headline"   }
      ],
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "General Sans",
          "fontFamily": "'General Sans', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "General Sans",
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/GeneralSans-Variable.woff2"]
            },
            {
              "fontFamily": "General Sans",
              "fontWeight": "300 700",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/GeneralSans-VariableItalic.woff2"]
            }
          ]
        },
        {
          "slug": "display",
          "name": "General Sans",
          "fontFamily": "'General Sans', system-ui, sans-serif"
        }
      ]
    }
  }
}
